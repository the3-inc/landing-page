{
	"name": "landing-page",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=26.12.1 <27"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "astro check",
		"test": "vitest run",
		"pack:design": "python3 scripts/pack_design.py .design-dist",
		"test:browser": "node tests/design-browser.cjs"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"lefthook": "2.2.2",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"astro": "7.3.8",
		"@the3/brand": "workspace:*"
	}
}
