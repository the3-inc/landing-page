---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
}
// biome-ignore lint/correctness/noUnusedVariables: Biome does not track references in Astro templates.
const { title, description } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Biome does not track references in Astro templates.
const currentPage = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fafbf9" media={import.meta.env.DEV ? undefined : "(prefers-color-scheme: light)"} />
		{!import.meta.env.DEV && <meta name="theme-color" content="#121916" media="(prefers-color-scheme: dark)" />}
		{import.meta.env.DEV && (
			<script is:inline>
				const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
				let preference = "system";
				try {
					const saved = localStorage.getItem("theme");
					if (saved === "light" || saved === "dark") preference = saved;
				} catch {
					// Storage can be unavailable; the selector still works for this visit.
				}
				function applyTheme() {
					const dark = preference === "dark" || (preference === "system" && systemTheme.matches);
					document.documentElement.dataset.theme = dark ? "dark" : "light";
					document.querySelector('meta[name="theme-color"]').content = dark ? "#121916" : "#fafbf9";
				}
				applyTheme();
				systemTheme.addEventListener("change", applyTheme);
				document.addEventListener("DOMContentLoaded", () => {
					const selector = document.getElementById("theme-select");
					selector.value = preference;
					selector.closest("label").hidden = false;
					selector.addEventListener("change", () => {
						preference = selector.value;
						applyTheme();
						try {
							if (preference === "system") localStorage.removeItem("theme");
							else localStorage.setItem("theme", preference);
						} catch {
							// Keep the selected theme even when it cannot be saved.
						}
					});
				});
			</script>
		)}
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title}</title>
	</head>
	<body class="font-sans antialiased">
		<a href="#main" class="sr-only fixed top-4 left-4 z-50 bg-forest px-6 py-3 text-on-forest focus:not-sr-only">本文へスキップ</a>
		<header class="border-b border-line bg-paper">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-6 md:px-12">
				<a href="/" aria-label="the3合同会社 トップ" class="text-3xl font-black tracking-tighter">the3<span class="text-sm">.</span></a>
				<div class="flex flex-wrap items-center gap-5">
					{import.meta.env.DEV && (
						<label hidden class="text-xs font-bold text-muted">
							表示
							<select id="theme-select" aria-label="表示テーマ" class="ml-2 rounded-md border border-line bg-paper px-2 py-2 text-ink">
								<option value="system">システム</option>
								<option value="light">ライト</option>
								<option value="dark">ダーク</option>
							</select>
						</label>
					)}
					<nav aria-label="メインナビゲーション" class="flex flex-wrap items-center gap-3 text-xs font-bold whitespace-nowrap sm:gap-8 sm:text-sm">
						<a href="/" aria-current={currentPage === "" ? "page" : undefined} class="hover:underline aria-[current=page]:underline underline-offset-8">トップ</a>
						<a href="/products/" aria-current={currentPage === "/products" ? "page" : undefined} class="hover:underline underline-offset-8">製品</a>
						<a href="/company/" aria-current={currentPage === "/company" ? "page" : undefined} class="hover:underline aria-[current=page]:underline underline-offset-8">会社案内</a>
						<a href="/contact/" aria-current={currentPage === "/contact" ? "page" : undefined} class="rounded-full bg-forest px-3 py-2 text-on-forest sm:px-5 sm:py-3 transition-opacity hover:opacity-80 inline-flex">お問い合わせ <span aria-hidden="true" class="ml-4">↗</span></a>
					</nav>
				</div>
			</div>
		</header>
		<main id="main"><slot /></main>
		<footer class="mx-auto flex border-t border-line w-full max-w-7xl flex-wrap items-center justify-between gap-6 px-6 py-8 md:px-12"><p class="text-xl font-black tracking-tight">the3<span class="text-xs">.</span> <span class="ml-3 text-xs font-normal tracking-normal">the3合同会社</span></p><p class="text-[10px] tracking-wider text-muted">© {new Date().getFullYear()} the3合同会社</p></footer>
	</body>
</html>
