---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
}
// biome-ignore lint/correctness/noUnusedVariables: Biome does not track references in Astro templates.
const { title, description } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Biome does not track references in Astro templates.
const currentPage = Astro.url.pathname.replace(/\/$/, "");
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "";
if (ga4Id && !/^G-[A-Z0-9]+$/.test(ga4Id)) {
	throw new Error(
		"PUBLIC_GA4_MEASUREMENT_ID must start with G- and contain uppercase letters or digits.",
	);
}
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/brand/the3-symbol.svg" />
		<meta name="theme-color" content="#fafcfc" media={import.meta.env.DEV ? undefined : "(prefers-color-scheme: light)"} />
		{!import.meta.env.DEV && <meta name="theme-color" content="#101a1c" media="(prefers-color-scheme: dark)" />}
		{import.meta.env.DEV && (
			<script is:inline>
				const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
				let preference = "system";
				try {
					const saved = localStorage.getItem("theme");
					if (saved === "light" || saved === "dark") preference = saved;
				} catch {
					// Storage can be unavailable; the selector still works for this visit.
				}
				function applyTheme() {
					const dark = preference === "dark" || (preference === "system" && systemTheme.matches);
					document.documentElement.dataset.theme = dark ? "dark" : "light";
					document.querySelector('meta[name="theme-color"]').content = dark ? "#101a1c" : "#fafcfc";
				}
				applyTheme();
				systemTheme.addEventListener("change", applyTheme);
				document.addEventListener("DOMContentLoaded", () => {
					const selector = document.getElementById("theme-select");
					selector.value = preference;
					selector.closest("label").hidden = false;
					selector.addEventListener("change", () => {
						preference = selector.value;
						applyTheme();
						try {
							if (preference === "system") localStorage.removeItem("theme");
							else localStorage.setItem("theme", preference);
						} catch {
							// Keep the selected theme even when it cannot be saved.
						}
					});
				});
			</script>
		)}
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title}</title>
		{import.meta.env.PROD && ga4Id && (
			<script is:inline defer src="/analytics.js" data-ga4-id={ga4Id}></script>
		)}
	</head>
	<body>
		<a href="#main" class="the3-skip-link">本文へスキップ</a>
		<header>
			<div class="the3-site-header">
				<a href="/" aria-label="the3合同会社 トップ" class="flex items-center gap-2 font-serif text-[32px] tracking-tight">
					<img src="/brand/the3-symbol.svg" width="40" height="40" alt="" class="size-10 shrink-0 [filter:var(--artwork-filter,none)]" />
					the3.
				</a>
				<div class="contents md:flex md:flex-wrap md:items-center md:gap-5">
					{import.meta.env.DEV && (
						<label hidden class="text-xs font-bold text-muted">
							表示
							<select id="theme-select" aria-label="表示テーマ" class="ml-2 px-2 py-2">
								<option value="system">システム</option>
								<option value="light">ライト</option>
								<option value="dark">ダーク</option>
							</select>
						</label>
					)}
					<nav aria-label="メインナビゲーション" class="gap-5 text-xs whitespace-nowrap sm:gap-8 sm:text-sm">
						<a href="/" aria-current={currentPage === "" ? "page" : undefined} class="hover:underline aria-[current=page]:underline underline-offset-8">トップ</a>
						<a href="/products/" aria-current={currentPage === "/products" ? "page" : currentPage.startsWith("/products/") ? "location" : undefined} class="hover:underline aria-[current=page]:underline aria-[current=location]:underline underline-offset-8">製品</a>
						<a href="/company/" aria-current={currentPage === "/company" ? "page" : undefined} class="hover:underline aria-[current=page]:underline underline-offset-8">会社案内</a>
						<a href="/contact/" aria-current={currentPage === "/contact" ? "page" : undefined} class="hover:underline aria-[current=page]:underline underline-offset-8">お問い合わせ</a>
					</nav>
				</div>
			</div>
		</header>
		<main id="main"><slot /></main>
		<footer class="the3-container flex border-t border-line flex-wrap items-center justify-between gap-6 py-8"><p class="flex items-center gap-2 font-serif text-2xl tracking-tight"><img src="/brand/the3-symbol.svg" width="40" height="40" alt="" class="shrink-0 [filter:var(--artwork-filter,none)]" />the3. <span class="ml-3 font-sans text-xs tracking-normal">the3合同会社</span></p><p class="text-[10px] tracking-wider text-muted">© {new Date().getFullYear()} the3合同会社</p></footer>
		{import.meta.env.PROD && ga4Id && (
			<aside aria-label="アクセス解析について" class="the3-container pb-8 text-xs text-muted">
				<p>当サイトではGoogle Analyticsを利用し、Cookie等を用いて閲覧状況や利用時間を計測します。お問い合わせの入力内容はアクセス解析に送信しません。</p>
				<p><a class="underline" href="https://policies.google.com/technologies/partner-sites">Googleによるデータの利用</a> · <a class="underline" href="https://tools.google.com/dlpage/gaoptout">Google Analyticsの無効化</a></p>
			</aside>
		)}
	</body>
</html>
