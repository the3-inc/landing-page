---
// biome-ignore lint/correctness/noUnusedImports: Biome does not track component references in Astro templates.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
	title="the3合同会社 | 社会に一つでも多く価値あるものを提供する"
	description="the3合同会社は、ITと業務効率化を通じて、社会に一つでも多く価値あるものを提供します。"
>
	<section id="philosophy" aria-labelledby="hero-title" class="py-16 lg:py-20">
		<div class="mx-auto grid w-full max-w-7xl gap-12 px-6 md:px-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
			<div>
				<p class="mb-8 flex items-center gap-3 text-xs font-bold tracking-[0.18em]"><span class="h-2 w-2 rounded-full bg-forest" aria-hidden="true"></span> PHILOSOPHY</p>
				<h1 id="hero-title" class="text-[clamp(1.45rem,7.2vw,2rem)] md:text-[clamp(2rem,4vw,3.25rem)] leading-[1.5] font-bold tracking-[-0.06em]">社会に一つでも多く<br />価値あるものを提供する<span class="text-forest">。</span></h1>
				<p class="mt-7 max-w-lg text-sm leading-8 text-muted md:text-base">ITと業務効率化を通じて、<br />よりよい仕事、よりよい社会へ。<br />the3合同会社は、この想いを出発点に取り組みます。</p>
				<a href="/company/" class="mt-9 inline-flex items-center gap-10 border-b border-forest pb-3 text-sm font-bold">会社案内を見る <span aria-hidden="true">→</span></a>
			</div>
			<div class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden lg:mx-0 lg:justify-self-end rounded-tl-[5rem] rounded-br-[5rem] bg-artwork" aria-hidden="true">
				<svg viewBox="0 0 500 500" class="h-full w-full" fill="none">
					<defs><pattern id="grid" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M 50 0 L 0 0 0 50" stroke="#ffffff" stroke-opacity=".07" /></pattern></defs>
					<rect width="500" height="500" fill="url(#grid)" />
					<path d="M -30 395 L 530 115" stroke="#d5e7a2" stroke-opacity=".35" />
					<circle cx="195" cy="285" r="115" stroke="#d5e7a2" stroke-width="35" />
					<circle cx="305" cy="285" r="115" stroke="#f6f5ef" stroke-width="35" />
					<circle cx="250" cy="190" r="115" stroke="#88ac91" stroke-width="35" />
					<path d="M 407 78 L 429 78 L 429 100 M 429 78 L 400 107" stroke="#d5e7a2" stroke-width="2" />
				</svg>
				<div class="absolute top-7 left-8 text-[10px] tracking-[0.25em] text-white/70">THE3 / A BETTER TOMORROW</div>
				<div class="absolute bottom-7 left-8 text-xs text-white/70">小さな一歩を、社会の価値へ。</div>
			</div>
		</div>
	</section>
</SiteLayout>
