---
// biome-ignore lint/correctness/noUnusedImports: Biome does not track component references in Astro templates.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
	title="the3合同会社 | 社会に一つでも多く価値あるものを提供する"
	description="the3合同会社は、ITと業務効率化を通じて、社会に一つでも多く価値あるものを提供します。"
>
	<section id="philosophy" aria-labelledby="hero-title" class="hero">
		<div class="hero-content">
			<h1 id="hero-title">社会に一つでも多く<br />価値あるものを提供する。</h1>
			<p class="hero-description">ITと業務効率化を通じて、<br />よりよい仕事、よりよい社会へ。</p>
			<a href="/company/" class="hero-link">私たちについて<span aria-hidden="true">→</span></a>
		</div>
		<img class="hero-art" src="/images/value-growth.png" width="2029" height="775" alt="" fetchpriority="high" />
	</section>
	<section class="philosophy-note" aria-labelledby="philosophy-note-title">
		<p class="eyebrow">PHILOSOPHY</p>
		<h2 id="philosophy-note-title">一つの価値が、次の価値へ。</h2>
	</section>
</SiteLayout>

<style>
	.hero {
		position: relative;
		max-width: 1536px;
		margin-inline: auto;
		padding: 80px 5% 226px;
		isolation: isolate;
	}
	.hero-content {
		position: relative;
		z-index: 1;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.5rem, 6.35vw, 5.875rem);
		font-weight: 600;
		line-height: 1.37;
		letter-spacing: -0.065em;
	}
	.hero-description {
		margin-top: 40px;
		font-size: clamp(1rem, 1.65vw, 1.5rem);
		line-height: 1.85;
		letter-spacing: 0.025em;
	}
	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: 24px;
		min-height: 44px;
		margin-top: 34px;
		border-bottom: 1px solid currentColor;
		font-size: clamp(0.875rem, 1.3vw, 1.125rem);
		transition: opacity 160ms;
	}
	.hero-link:hover {
		opacity: 0.65;
	}
	.hero-art {
		position: absolute;
		z-index: 0;
		top: 180px;
		left: 0;
		width: 100%;
		height: auto;
		pointer-events: none;
		filter: var(--artwork-filter, none);
	}
	.philosophy-note {
		max-width: 1536px;
		margin: 0 auto;
		padding: 48px 5% 64px;
	}
	.eyebrow {
		margin: 0;
		color: var(--color-forest);
		font-size: 12px;
		letter-spacing: 0.25em;
	}
	h2 {
		margin-top: 26px;
		font-size: clamp(1.25rem, 2.1vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.025em;
	}
	@media (max-width: 767px) {
		.hero {
			padding: 60px 6% 0;
		}
		h1 {
			font-size: clamp(1.5rem, 6.7vw, 3.2rem);
			line-height: 1.65;
		}
		.hero-description {
			margin-top: 28px;
			font-size: 14px;
		}
		.hero-link {
			margin-top: 22px;
		}
		.hero-art {
			position: relative;
			top: auto;
			left: auto;
			width: calc(100% + 13.64%);
			max-width: none;
			margin: 12px -6.82% 0;
		}
		.philosophy-note {
			padding: 44px 6% 48px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-link {
			transition: none;
		}
	}
</style>
