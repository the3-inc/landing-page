---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout title="製品 | the3合同会社" description="the3合同会社の製品と、業務への導入・システム組み込みをご案内します。">
	<div class="the3-page-shell">
		<header class="the3-page-heading">
			<div>
				<p class="the3-page-kicker">PRODUCTS</p>
				<h1 id="products-title" class="the3-page-title">製品</h1>
				<p class="the3-page-lead">業務に合わせて、仕組みをつくる。<br />製品と、導入・開発の支援をご案内します。</p>
			</div>
		</header>
		<article class="the3-page-section" aria-labelledby="product-name">
			<p class="the3-page-kicker">01 / OPTIMIZATION</p>
			<div class="product-feature">
				<div>
					<h2 id="product-name">shift-schedula</h2>
					<p class="mt-4">担当配置・勤務計画の最適化エンジン</p>
				</div>
				<div>
					<p>技能、勤務可能時間、必要人数、勤務ルールから、担当配置と勤務計画を作成する最適化エンジンです。</p>
					<a href="/products/schedula/" class="the3-text-link mt-6">詳しく見る<span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>
		<section class="the3-page-cta" aria-labelledby="products-contact-title">
			<h2 id="products-contact-title">自社の業務への導入を、<br />一緒に考えます。</h2>
			<a href="/contact/" class="the3-text-link">導入・開発を相談する<span aria-hidden="true">→</span></a>
		</section>
	</div>
</SiteLayout>
