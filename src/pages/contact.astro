---
// biome-ignore lint/correctness/noUnusedImports: Biome does not track component references in Astro templates.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="お問い合わせ | the3合同会社" description="IT・業務効率化のご相談は、the3合同会社へメールまたは電話でお問い合わせください。">
	<div class="page-shell">
		<header class="page-heading">
			<div>
				<p class="page-kicker">CONTACT</p>
				<h1 id="contact-title" class="page-title">お問い合わせ</h1>
				<p class="page-lead">IT・業務効率化について、<br />お気軽にご相談ください。</p>
			</div>
		</header>
		<section class="page-section" aria-labelledby="contact-methods-title">
			<div>
				<p class="page-kicker">GET IN TOUCH</p>
				<h2 id="contact-methods-title" class="section-title">ご相談窓口</h2>
			</div>
			<div class="section-body">
				<div class="contact-option">
					<h3 class="page-kicker">01 / メール</h3>
					<a href="mailto:omitsuhashi@the3-o.com" class="text-link contact-address">omitsuhashi@the3-o.com</a>
				</div>
				<div class="contact-option">
					<h3 class="page-kicker">02 / 電話</h3>
					<a href="tel:08067462024" class="text-link contact-address">080-6746-2024</a>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>
